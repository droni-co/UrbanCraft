# Variables para docker-compose.prod.yml (copiar a .env.deploy, que no se versiona)
DOMAIN=urbancraft.droni.vip

# node ace generate:key --show  (o: openssl rand -base64 32)
APP_KEY=

DB_USER=urbancraft
DB_PASSWORD=
DB_DATABASE=urbancraft

# Inicio de sesión con Google (docs/login-google.md)
# URI de redireccionamiento autorizado: https://${DOMAIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
