static var _icons := {}


static func color(category: String) -> Color:
	return COLORS.get(category, COLORS.other)


static func icon(category: String) -> Texture2D:
	if not _icons.has(category):
		var path := ICON_DIR + category + ".png"
		_icons[category] = load(path) if ResourceLoader.exists(path) else null
	return _icons[category]


## "Restaurante · colombiana", "Panadería", "Oficina"…
static func describe(kind: String, detail := "") -> String:
	var text: String = KIND_NAMES.get(kind, kind.get_slice(":", 1).replace("_", " ").capitalize())
	if detail.is_empty():
		return text
	return text + " · " + str(CUISINES.get(detail.to_lower(), detail))
