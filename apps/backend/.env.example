# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (docker compose up -d en la raíz del monorepo)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=urbancraft
DB_PASSWORD=urbancraft
DB_DATABASE=urbancraft

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Map generation (OpenStreetMap vía Overpass)
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_WORKER_ENABLED=true
