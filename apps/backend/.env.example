# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (docker compose up -d en la raíz del monorepo)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=urbancraft
DB_PASSWORD=urbancraft
DB_DATABASE=urbancraft

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Map generation (OpenStreetMap vía Overpass)
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_WORKER_ENABLED=true

# Geolocalización (ciudad/país por Nominatim; ubicación aproximada por IP)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_IP_ENABLED=true

# Inicio de sesión con Google (docs/login-google.md)
# Google Cloud Console → Credenciales → ID de cliente OAuth → "Aplicación web".
# URI de redireccionamiento autorizado: http://localhost:3333/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por defecto ${APP_URL}/auth/google/callback
# GOOGLE_CALLBACK_URL=

# Usuarios de prueba sin Google, para depurar (POST /api/v1/auth/dev/login).
# Nunca funciona con NODE_ENV=production y solo acepta peticiones de esta máquina.
DEV_LOGIN_ENABLED=true

# Adelanta/atrasa la hora del juego (GET /api/v1/time) para probar el día y la noche.
# Se ignora con NODE_ENV=production.
# DEV_CLOCK_OFFSET_HOURS=12
